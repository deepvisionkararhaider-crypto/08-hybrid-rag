# ---------------------------------------------------------------------------
# Hybrid RAG configuration. Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Embeddings / dense store ---
EMBEDDING_PROVIDER=auto          # auto | hashing | sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE=auto                # auto | numpy | faiss

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- BM25 (lexical retriever) ---
BM25_K1=1.5
BM25_B=0.75

# --- Hybrid retrieval ---
TOP_K=5
PER_RETRIEVER_K=10
FUSION=rrf                       # rrf | weighted
RRF_K=60
DENSE_WEIGHT=0.5                 # only used when FUSION=weighted
LEXICAL_WEIGHT=0.5               # only used when FUSION=weighted

# --- Generation ---
LLM_PROVIDER=extractive          # extractive | openai | huggingface
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
DATA_DIR=./data
INDEX_DIR=./index
LOG_LEVEL=INFO
